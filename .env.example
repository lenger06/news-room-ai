NEWSROOM_NAME="Defy Logic News"

OPENAI_API_KEY="sk-..."
TAVILY_API_KEY="tvly-..."
PIXABAY_API_KEY=""         # Free at pixabay.com/api — used for video b-roll search

# HeyGen — AI anchor video generation (https://app.heygen.com/settings?nav=API)
HEYGEN_API_KEY="..."
HEYGEN_AVATAR_ID=""   # From: GET https://api.heygen.com/v2/avatars
HEYGEN_VOICE_ID=""    # From: GET https://api.heygen.com/v2/voices

# YouTube — publisher agent
# Download OAuth2 credentials from Google Cloud Console → APIs & Services → Credentials
YOUTUBE_CLIENT_SECRETS_PATH=credentials/youtube_client_secrets.json

HOST=0.0.0.0
PORT=8091
DEBUG=True
LOG_LEVEL=INFO

ARTICLES_DIR=./output/articles
SCRIPTS_DIR=./output/scripts
MEDIA_DIR=./output/media

# Per-agent model overrides — all default to gpt-4o, uncomment to override individually
# MODEL_FACT_CHECKER=gpt-4o
# MODEL_COMPLIANCE_CHECKER=gpt-4o
# MODEL_WRITER=gpt-4o

# Event feeds (USGS earthquakes, NWS weather alerts) — disabled by default, see README
EVENT_FEEDS_ENABLED=False
EVENT_FEED_POLL_SECONDS=300
EVENT_FEED_MIN_MAGNITUDE=6.0
EVENT_FEED_NWS_SEVERITIES=Extreme,Severe
EVENT_FEED_USER_AGENT="news-room-ai (contact: you@example.com)"
